import time
import subprocess
from collections import defaultdict
from datetime import datetime, timedelta

#Important Variables
LOG_FILE = "/var/log/secure"
THRESHOLD = 5         #Number of failed attempts
TIME_WINDOW = 60      #Time window in seconds

failed_attempts = defaultdict(list)

def block_ip(ip_address):
    print(f"THRESHOLD REACHED: {THRESHOLD} attempts for {ip_address}")
    try:
        subprocess.run(["sudo", "firewall-cmd", "--permanent", "--zone=drop", "--add-source=" + ip_address], check=True)
        subprocess.run(["sudo", "firewall-cmd", "--reload"], check=True)
        print(f"Successfully locked out {ip_address} using firewalld drop zone.\n")
    except subprocess.CalledProcessError as e:
        print(f” Error executing firewall-cmd: {e}")

def monitor_logs():
    print(f" Monitoring {LOG_FILE} for failed SSH logins...")
    #move to the end of file 
    with open(LOG_FILE, "r") as f:
        f.seek(0, 2)  
        
        while True:
            line = f.readline()
            if not line:
                time.sleep(0.1)
                continue
            
            if "Failed password" in line:
                try:
                    #Obtain IP address here
                    parts = line.split("from")
                    attacker_ip = parts[1].strip().split()[0]
                    
                    now = datetime.now()
                    
                    # Clean up old timestamps outside our time window
                    failed_attempts[attacker_ip] = [
                        t for t in failed_attempts[attacker_ip] 
                        if now - t < timedelta(seconds=TIME_WINDOW)
                    ]
                    
                    failed_attempts[attacker_ip].append(now)
                    current_count = len(failed_attempts[attacker_ip])
                    print(f"Failed login from {attacker_ip} -> Count: {current_count}/{THRESHOLD}")
          
                    if current_count >= THRESHOLD:
                        block_ip(attacker_ip)
                        failed_attempts[attacker_ip] = []
                except Exception as e:
                    print(f"Error: {e}")

if __name__ == "__main__":
    try:
        monitor_logs()
    except KeyboardInterrupt:
        print("Stopping defense script.")
